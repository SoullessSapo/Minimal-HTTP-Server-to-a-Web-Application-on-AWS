# The shell scripts and the systemd unit are executed on Linux. Without this, a clone on Windows
# with core.autocrlf=true rewrites them with CRLF endings and the instance answers
# "$'\r': command not found" when the installer runs.
*.sh text eol=lf
*.service text eol=lf

# Web resources keep LF as well, so the bytes served are identical on every platform.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.java text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
